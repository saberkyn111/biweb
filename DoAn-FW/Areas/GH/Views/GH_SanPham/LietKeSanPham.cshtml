@model IEnumerable<Web_projectframeword_admin.Models.SanPham>
@{
    <div class="content-wrapper" style="min-height: 639px;">
        <section class="content-header">
            <h1>
                <i class="fa fa-cubes"></i> Kho Phần Mềm & Tool Ads
            </h1>
            <div class="breadcrumb">
                <form action="/GH/GH_SanPham/FindSanPham" method="post">
                    <div class="searchbox">
                        <input type="text" placeholder="Tìm kiếm sản phẩm..." name="ten">
                        <button type="submit" style="width: 50px; height: 25px; background-color: darkcyan; border-radius: 10px; color: white; border-color: white; ">
                            <i class="fas fa-search-location"></i>
                        </button>
                    </div>
                    
                </form>
            </div>
        </section>
        <section class="content">
            <div class="row">
                <div class="col-md-12">
                    <div class="box" id="view">
                        <div class="box-header with-border">
                            <div class="box-body">
                                <div class="row" style="padding:0px; margin:0px;">
                                    <div class="table-responsive">
                                        <table class="table table-hover table-bordered">
                                            <thead>
                                                <tr>
                                                    <th class="text-center" style="width:70px">Mã TTSP</th>
                                                    <th>Tên Tool / Phần mềm</th>
                                                    <th>Hình ảnh</th>
                                                    <th>Loại sản phẩm</th>
                                                    <th>Đơn vị phát triển</th>
                                                    <th>Số lượng License</th>
                                                    <th class="text-center" colspan="1">Thao tác</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td class="text-center">@item.MATTSP</td>
                                                        <td style="font-size: 15px; font-weight: 600;">@item.TENSP</td>
                                                        <td style="width:120px">
                                                            <img src="@item.HINHANH" alt="@item.TENSP" class="img-responsive" style="max-height: 70px; object-fit: cover; border-radius: 6px;">
                                                        </td>
                                                        <td><span class="label label-info">@item.TENLOAISP</span></td>
                                                        <td><span class="label label-primary">@item.TENTH</span></td>
                                                        <td><span class="badge bg-green">@item.SOLUONG</span></td>
                                                        <td class="text-center">
                                                            <a class="btn btn-success btn-xs" href="/GH/GH_SanPham/ViewSanPham?Id=@item.MATTSP" role="button">
                                                                <span class="glyphicon glyphicon-eye-open"></span> Xem Chi Tiết
                                                            </a>
                                                        </td>
                                                        
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @{ int pages = Convert.ToInt32(ViewData["pages"]); int p = Convert.ToInt32(ViewData["page"]);}
            <div class="row">
                <div class="col-md-12 text-center">
                    <ul class="pagination">
                        <form action="/GH/GH_SanPham/LietKeSanPham" method="get">
                            <input type="submit" value="Go to" /> page <input type="number" max="@pages" min="1" name="page" value="@p" /> of @pages
                        </form>
                    </ul>
                </div>
            </div>        
        </section>
    </div>
}
