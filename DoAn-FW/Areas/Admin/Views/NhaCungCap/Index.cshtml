@model IEnumerable<Web_projectframeword_admin.Models.NhaCungCap>
@{
    <div class="content-wrapper" style="min-height: 639px; background-color: #f4f6f9;">
        <section class="content-header" style="padding: 20px 20px 10px 20px;">
            <div class="row" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
                <div class="col-sm-6">
                    <h1 style="font-size: 22px; font-weight: 700; margin: 0; color: #1e293b;">
                        <i class="fa fa-handshake" style="color: #1877f2; margin-right: 8px;"></i> Danh Sách Đơn Vị Phát Triển & Đối Tác Tool
                    </h1>
                </div>
                <div class="col-sm-6 text-right" style="margin-top: 10px;">
                    <a class="btn btn-primary" href="/Admin/NhaCungCap/ThemNCC" role="button" style="background: #1877f2; border-color: #1877f2; border-radius: 6px; font-weight: 600; font-size: 13px; padding: 6px 14px;">
                        <i class="fa fa-plus"></i> Thêm Nhà Cung Cấp Mới
                    </a>
                </div>
            </div>
        </section>

        <section class="content" style="padding: 15px 20px;">
            <div class="row">
                <div class="col-md-12">
                    <div class="box box-primary" style="border-radius: 12px; border-top: 3px solid #1877f2; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); background: #ffffff;">
                        <div class="box-body" style="padding: 15px;">
                            <div class="table-responsive">
                                <table class="table table-hover table-striped" style="margin-bottom: 0; font-size: 13px;">
                                    <thead>
                                        <tr style="background: #f8fafc; color: #475569; font-weight: 700; border-bottom: 2px solid #e2e8f0;">
                                            <th class="text-center" style="width: 70px;">Mã</th>
                                            <th>Tên Đơn Vị Phát Triển</th>
                                            <th>Email Liên Hệ</th>
                                            <th>Số Điện Thoại</th>
                                            <th>Địa Chỉ Trụ Sở</th>
                                            <th>Website Chính Thức</th>
                                            <th class="text-center" style="width: 140px;">Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr style="vertical-align: middle;">
                                                <td class="text-center" style="font-weight: 700; color: #64748b;">@item.mancc</td>
                                                <td style="font-weight: 600; color: #1877f2; font-size: 14px;">
                                                    <i class="fa fa-building" style="color: #94a3b8; margin-right: 6px;"></i> @item.tenncc
                                                </td>
                                                <td>
                                                    <a href="mailto:@item.email" style="color: #0284c7; text-decoration: none;">
                                                        <i class="fa fa-envelope" style="margin-right: 4px;"></i> @item.email
                                                    </a>
                                                </td>
                                                <td style="font-weight: 500; color: #334155;">
                                                    <i class="fa fa-phone" style="color: #10b981; margin-right: 4px;"></i> @item.sdt
                                                </td>
                                                <td style="color: #475569;">@item.diachi</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(item.website))
                                                    {
                                                        <a href="@item.website" target="_blank" style="color: #2563eb; text-decoration: none; font-weight: 500;">
                                                            <i class="fa fa-external-link-alt" style="margin-right: 4px; font-size: 11px;"></i> @item.website
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">N/A</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <a class="btn btn-success btn-xs" href="/Admin/NhaCungCap/SuaNCC?id=@item.mancc" role="button" style="border-radius: 4px; padding: 4px 10px; margin-right: 4px;">
                                                        <i class="fa fa-edit"></i> Sửa
                                                    </a>
                                                    <a class="btn btn-danger btn-xs" href="/Admin/NhaCungCap/Index?id=@item.mancc" onclick="return confirm('Xác nhận xóa nhà cung cấp này khỏi hệ thống?')" role="button" style="border-radius: 4px; padding: 4px 10px;">
                                                        <i class="fa fa-trash"></i> Xóa
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
}