
@{
    <div class="content-wrapper" style="min-height: 639px;">
        <section class="content-header">
            <h1><i class="glyphicon glyphicon-bookmark"></i> Hệ Thống</h1>
            <div class="breadcrumb">
                <button type="submit" class="btn btn-primary btn-sm">
                    <span class="glyphicon glyphicon-floppy-save"></span>
                    Lưu
                </button>
            </div>
        </section>
        <!-- Main content -->
        <section class="content">
            <div class="row">
                <div class="col-md-12">
                    <div class="box" id="view">
                        <div class="box-body">
                            <div class="col-md-9">
                                <div class="form-group">
                                    <label> Mail hệ thống</label>
                                    <input type="email" class="form-control" name="mail_ht" style="width:100%" placeholder="Mail cấu hình" value="system@fbtools.vn">
                                </div>
                                <div class="form-group">
                                    <label>Password Mail hệ thống</label>
                                    <input type="password" class="form-control" name="mail_ht_password" style="width:100%" placeholder=" Password Mail cấu hình" value="123456">
                                </div>
                                <div class="form-group">
                                    <label>Mail admin tiếp nhận đơn hàng</label>
                                    <input type="text" class="form-control" name="mail_noreply" style="width:100%" placeholder="Mail nhận thông tin đơn hàng" value="admin@fbtools.vn">
                                </div>
                                <div class="form-group">
                                    <label> Tiêu đề Website (Title)</label>
                                    <input type="text" class="form-control" name="title" style="width:100%" placeholder=" title" value="FB ADS TOOL STORE - Hệ thống bán tool Facebook & Ads tự động hóa">
                                </div>
                                <div class="form-group">
                                    <label> Mô tả hệ thống (Meta Description)</label>
                                    <input type="text" class="form-control" name="description" style="width:100%" placeholder=" description" value="Hệ thống cung cấp phần mềm nuôi nick, auto camp FB Ads, quét UID và nguyên liệu quảng cáo hàng đầu Việt Nam">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                        </div>
                    </div>
                </div><!-- /.box -->
            </div>
            <!-- /.col -->
        </section>
    </div>
}
