        var sampleOrders = [
            { user: "Minh Quân (Hà Nội)", tool: "Tool Auto Lên Camp & CBO v5.4", time: "2 phút trước" },
            { user: "Hoàng Long (TP.HCM)", tool: "MaxCare Nuôi Nick Kháng 282", time: "5 phút trước" },
            { user: "Anh Tuấn (Đà Nẵng)", tool: "Simple UID Pro Quét Livestream", time: "1 phút trước" },
            { user: "Thu Trang (Hải Phòng)", tool: "Gói 10x Tài Khoản BM50 Kháng", time: "8 phút trước" },
            { user: "Văn Hùng (Cần Thơ)", tool: "Ninja Auto Post & Rải Comment", time: "4 phút trước" }
        ];

        var toastIndex = 0;
        function showNextToast() {
            var toast = document.getElementById('liveOrderToast');
            if (!toast) return;

            var item = sampleOrders[toastIndex % sampleOrders.length];
            toastIndex++;

            document.getElementById('toastUser').innerText = item.user;
            document.getElementById('toastProduct').innerText = item.tool;
            document.getElementById('toastTime').innerText = item.time;

            toast.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');

            setTimeout(function() {
                dismissToast();
            }, 5000);
        }

        function dismissToast() {
            var toast = document.getElementById('liveOrderToast');
            if (toast) {
                toast.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
                toast.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
            }
        }

        // Start toast cycle after 4 seconds
        setTimeout(function() {
            showNextToast();
            setInterval(showNextToast, 22000);
        }, 4000);

        // Mobile menu toggle
        function toggleMobileMenu() {
            var menu = document.getElementById('mobileMenu');
            var icon = document.getElementById('iconMobileMenu');
            if (!menu) return;
            var open = menu.classList.toggle('hidden') === false;
            if (icon) icon.className = open ? 'fa fa-times' : 'fa fa-bars';
        }

        // Header shadow on scroll
        (function () {
            var header = document.getElementById('siteHeader');
            function onScroll() { if (header) header.classList.toggle('is-scrolled', window.scrollY > 10); }
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
