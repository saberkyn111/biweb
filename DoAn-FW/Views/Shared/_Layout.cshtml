                <a href="tel:0909008064" class="text-white hover:text-[#00C6FF] flex items-center font-bold no-underline transition">
                    <i class="fa fa-phone-alt text-[#FF6B00] mr-1.5"></i> Hotline Chiến Lược: 0909 008 064
                </a>
                <a href="https://webplus.biweb.vn" target="_blank" class="text-white/90 hover:text-white flex items-center font-medium no-underline">
                    <i class="fa fa-globe text-[#00C6FF] mr-1.5"></i> webplus.biweb.vn
