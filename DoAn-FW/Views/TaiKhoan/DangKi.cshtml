@{
    ViewData["Title"] = "Đăng Ký Tài Khoản Doanh Nghiệp - BIWEB";
}

<script>
    function check(input) {
        var msg = document.querySelector('.message');
        var pass = document.getElementById('MatKhau').value;
        if (input.value !== pass) {
            msg.innerText = "Mật khẩu nhập lại không khớp!";
            msg.className = "message text-xs font-semibold text-rose-400 mt-1 block";
        } else {
            msg.innerText = "Mật khẩu trùng khớp ✓";
            msg.className = "message text-xs font-semibold text-emerald-400 mt-1 block";
        }
    }
</script>

<!-- Breadcrumb Header -->
<div class="bg-transparent text-white py-8 border-b border-white/10 relative overflow-hidden">
    <div class="container mx-auto px-4 relative z-10">
        <div class="flex items-center space-x-2 text-xs text-[#00C6FF] font-medium mb-1">
            <a href="/Home/Index" class="hover:text-white no-underline text-[#00C6FF]">Trang chủ</a>
            <span class="text-slate-500">/</span>
            <span class="text-white">Đăng ký doanh nghiệp</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Tạo Tài Khoản Doanh Nghiệp BIWEB
        </h1>
        <p class="text-xs sm:text-sm text-slate-300 mt-1 m-0">
            Gia nhập hệ sinh thái MarTech, CDP, ERP & AI Agent phục vụ 50+ đối tác doanh nghiệp lớn
        </p>
    </div>
</div>

<div class="py-14 bg-transparent min-h-[600px] flex items-center justify-center">
    <div class="container mx-auto px-4 max-w-2xl">
        
        <div class="bi-dark-card rounded-3xl border border-white/15 p-8 sm:p-10 shadow-[0_25px_60px_rgba(0,0,0,0.8),0_0_30px_rgba(0,198,255,0.15)] relative overflow-hidden backdrop-blur-2xl">
            <!-- Glow Accent -->
            <div class="absolute -top-20 -right-20 w-44 h-44 bg-[#0052FF]/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-20 -left-20 w-44 h-44 bg-[#00C6FF]/15 rounded-full blur-3xl pointer-events-none"></div>

            <div class="text-center mb-8">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-[#0052FF] via-[#00C6FF] to-[#FF6B00] text-white flex items-center justify-center mx-auto mb-4 text-2xl shadow-lg shadow-[#0052FF]/30 font-black">
                    <i class="fa fa-user-plus"></i>
                </div>
                <h2 class="text-2xl font-black text-white tracking-tight">Đăng Ký Tài Khoản Doanh Nghiệp</h2>
                <p class="text-xs text-slate-300 mt-1">Điền đầy đủ thông tin để kích hoạt tài khoản giải pháp và nhận License trải nghiệm</p>
            </div>

            <form action="/TaiKhoan/ThemTK" method="post" class="dangki space-y-5">
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="TenKH" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                            Họ và tên / Đại diện *
                        </label>
                        <input name="TenKH"
                               type="text"
                               required
                               class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/90 border border-white/15 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#00C6FF] focus:ring-1 focus:ring-[#00C6FF]/40 transition"
                               id="TenKH" placeholder="Nguyễn Văn A"/>
                    </div>

                    <div>
                        <label for="GioiTinh" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                            Giới tính
                        </label>
                        <select name="GioiTinh"
                                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/90 border border-white/15 text-sm text-white focus:outline-none focus:border-[#00C6FF] focus:ring-1 focus:ring-[#00C6FF]/40 transition"
                                id="GioiTinh">
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>    
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="SDT" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                            Số điện thoại / Zalo *
                        </label>
                        <input name="SDT"
                               type="text"
                               required
                               class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/90 border border-white/15 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#00C6FF] focus:ring-1 focus:ring-[#00C6FF]/40 transition"
                               id="SDT" placeholder="0912345678"/>
                    </div>

                    <div>
                        <label for="Email" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                            Email (Nhận License Key) *
                        </label>
                        <input name="Email"
                               type="email"
                               required
                               class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/90 border border-white/15 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#00C6FF] focus:ring-1 focus:ring-[#00C6FF]/40 transition"
                               id="Email" placeholder="agency@fbtool.com" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="CMND" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                            Mã số thuế / CCCD
                        </label>
                        <input name="CMND"
                               type="text"
                               class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/90 border border-white/15 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#00C6FF] focus:ring-1 focus:ring-[#00C6FF]/40 transition"
                               id="CMND" placeholder="001200000000 / MST Doanh nghiệp"/>
                    </div>

                    <div>
                        <label for="DiaChi" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                            Địa chỉ / Tỉnh thành
                        </label>
                        <input name="DiaChi"
                               type="text"
                               class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/90 border border-white/15 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#00C6FF] focus:ring-1 focus:ring-[#00C6FF]/40 transition"
                               id="DiaChi" placeholder="Hà Nội / Hồ Chí Minh"/>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label for="MatKhau" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                            Mật khẩu *
                        </label>
                        <input name="MatKhau"
                               type="password"
                               required
                               class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/90 border border-white/15 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#00C6FF] focus:ring-1 focus:ring-[#00C6FF]/40 transition"
                               id="MatKhau" placeholder="Tối thiểu 6 ký tự"/>
                    </div>

                    <div>
                        <label for="confirm-pass" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                            Xác nhận mật khẩu *
                        </label>
                        <input name="confirm-pass"
                               type="password"
                               required
                               class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/90 border border-white/15 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#00C6FF] focus:ring-1 focus:ring-[#00C6FF]/40 transition"
                               id="confirm-pass" 
                               placeholder="Nhập lại mật khẩu"
                               oninput="check(this)"/>
                        <div class="message"></div>
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit"
                            class="w-full py-3.5 px-4 rounded-xl font-bold text-white bi-btn-primary shadow-lg shadow-[#0052FF]/30 transition duration-150 flex items-center justify-center space-x-2 text-sm border-0 cursor-pointer">
                        <i class="fa fa-user-check"></i>
                        <span>Hoàn Tất Đăng Ký Tài Khoản</span>
                    </button>
                </div>
            </form>

            <div class="mt-8 pt-6 border-t border-white/10 text-center">
                <p class="text-xs text-slate-400 m-0">
                    Đã có tài khoản? 
                    <a href="/TaiKhoan/DangNhap" class="font-bold text-[#00C6FF] hover:text-[#38bdf8] hover:underline ml-1">
                        Đăng nhập ngay
                    </a>
                </p>
            </div>
        </div>

    </div>
</div>
