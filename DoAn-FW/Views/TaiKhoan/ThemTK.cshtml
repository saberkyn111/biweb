@{
    ViewData["Title"] = "Kết Quả Đăng Ký Tài Khoản - BIWEB";
    var count = ViewData["count"];
    bool isSuccess = false;
    if (count != null && int.TryParse(count.ToString(), out int c) && c >= 0)
    {
        isSuccess = true;
    }
}

<div class="py-16 bg-[#F8FAFC] min-h-[600px] flex items-center justify-center">
    <div class="container mx-auto px-4 max-w-lg">
        
        <div class="bi-card-white rounded-3xl border border-slate-200/80 p-8 sm:p-10 shadow-xl text-center relative overflow-hidden">
            @if (isSuccess)
            {
                <div class="w-20 h-20 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-6 text-3xl shadow-lg shadow-emerald-500/20">
                    <i class="fa fa-check"></i>
                </div>
                <h2 class="text-2xl font-black text-[#0F172A] mb-2">Đăng Ký Thành Công!</h2>
                <p class="text-sm text-[#4B5563] mb-8 leading-relaxed">
                    Tài khoản của bạn đã được khởi tạo thành công trên hệ thống BIWEB. Bạn có thể đăng nhập ngay để bắt đầu sử dụng và khám phá các giải pháp MarTech & ERP.
                </p>
                <div class="space-y-3">
                    <a href="/TaiKhoan/DangNhap" class="w-full inline-flex items-center justify-center py-3.5 px-6 rounded-xl font-bold text-white bi-btn-primary shadow-md shadow-[#0052FF]/25 transition text-sm no-underline">
                        <i class="fa fa-sign-in-alt mr-2"></i> Đăng Nhập Ngay
                    </a>
                    <a href="/Home/Index" class="w-full inline-flex items-center justify-center py-3 px-6 rounded-xl font-medium text-[#4B5563] hover:bg-slate-100 transition text-xs no-underline">
                        Quay lại trang chủ
                    </a>
                </div>
            }
            else
            {
                <div class="w-20 h-20 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-6 text-3xl shadow-lg shadow-rose-500/20">
                    <i class="fa fa-times"></i>
                </div>
                <h2 class="text-2xl font-black text-slate-900 mb-2">Đăng Ký Thất Bại!</h2>
                <p class="text-sm text-slate-600 mb-8 leading-relaxed">
                    Đã có lỗi xảy ra trong quá trình khởi tạo tài khoản (Email hoặc thông tin có thể đã tồn tại). Vui lòng thử lại.
                </p>
                <div class="space-y-3">
                    <a href="/TaiKhoan/DangKi" class="w-full inline-flex items-center justify-center py-3.5 px-6 rounded-xl font-bold text-white bg-rose-600 hover:bg-rose-700 shadow-md transition text-sm no-underline">
                        <i class="fa fa-redo mr-2"></i> Thử Đăng Ký Lại
                    </a>
                    <a href="/Home/Index" class="w-full inline-flex items-center justify-center py-3 px-6 rounded-xl font-medium text-slate-600 hover:bg-slate-100 transition text-xs no-underline">
                        Quay lại trang chủ
                    </a>
                </div>
            }
        </div>

    </div>
</div>
