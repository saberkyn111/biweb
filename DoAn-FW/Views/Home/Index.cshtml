                            <a href="/SanPham/ChiTietSP?t=@id&l=@loaiId" class="inline-flex items-center justify-center px-3 py-2.5 rounded-xl text-xs font-bold text-[#0F172A] bg-slate-100 hover:bg-slate-200 transition no-underline">
