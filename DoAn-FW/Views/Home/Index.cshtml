<script>
    // Product category quick filter on homepage (with high-specificity CSS class toggling)
    function filterHomeCategory(catId, btn) {
        // Reset all buttons
        var buttons = document.querySelectorAll('.home-cat-btn');
        buttons.forEach(function (b) {
            b.className = 'home-cat-btn px-4 py-2.5 rounded-xl text-xs font-semibold bg-white hover:bg-slate-50 text-[#4B5563] border border-slate-200 cursor-pointer transition whitespace-nowrap shadow-sm flex items-center gap-1.5';
            var badge = b.querySelector('span:last-child');
            if (badge) {
                badge.className = 'ml-1 px-1.5 py-0.5 rounded-md bg-slate-100 text-[10px] text-slate-600 font-bold';
            }
        });

        // Set active button
        if (btn) {
            btn.className = 'home-cat-btn px-4 py-2.5 rounded-xl text-xs font-bold bi-btn-primary text-white shadow-sm border-0 cursor-pointer whitespace-nowrap transition flex items-center gap-1.5';
            var activeBadge = btn.querySelector('span:last-child');
            if (activeBadge) {
                activeBadge.className = 'ml-1 px-1.5 py-0.5 rounded-md bg-white/20 text-[10px] text-white font-bold';
            }
        }

        // Category labels mapping
        var catLabels = {
            'all': '',
            '1': '• MarTech & Tối Ưu Ads',
            '2': '• ERP, Nuôi Nick & AI',
            '3': '• CDP & Quét Data Khách',
            '4': '• Omnichannel & Tin Nhắn',
            '5': '• Hạ Tầng Cloud & Proxy'
        };
        var labelEl = document.getElementById('homeFilterLabel');
        if (labelEl) {
            labelEl.innerText = catLabels[catId] || '';
        }

        // Filter cards
        var cards = document.querySelectorAll('.product-home-card');
        var matched = 0;
        cards.forEach(function (c) {
            var cCat = (c.getAttribute('data-category') || '').trim();
            var isMatch = (catId === 'all' || cCat === String(catId));
            if (isMatch) { 
                c.classList.remove('is-hidden', 'hidden'); 
                c.classList.add('is-visible', 'flex');
                c.style.setProperty('display', 'flex', 'important');
                matched++; 
            } else { 
                c.classList.remove('is-visible', 'flex');
                c.classList.add('is-hidden', 'hidden'); 
                c.style.setProperty('display', 'none', 'important');
            }
        });

        // Update count badge
        var countEl = document.getElementById('homeFilterCount');
        if (countEl) {
            countEl.innerText = matched + '/' + cards.length;
        }

        // Show/hide empty notice
        var emptyEl = document.getElementById('homeEmptyNotice');
        if (emptyEl) {
            if (matched === 0) {
                emptyEl.classList.remove('hidden');
                emptyEl.style.setProperty('display', 'block', 'important');
            } else {
                emptyEl.classList.add('hidden');
                emptyEl.style.setProperty('display', 'none', 'important');
            }
        }
    }

    // Consultation submission
    function submitConsult(e) {
        e.preventDefault();
        var ok = document.getElementById('consultSuccess');
        if (ok) ok.classList.remove('hidden');
        var form = document.getElementById('consultForm');
        if (form) form.reset();
        return false;
    }
</script>
