@{
    ViewData["Title"] = "BIWEB - Martech Cho Doanh Nghiệp Số | Tăng Trưởng Bền Vững Với ERP & AI Agent";
    List<object> ListSP = ViewBag.ListSP ?? new List<object>();
    List<object> ListLoaiSP = ViewBag.ListLoaiSP as List<object> ?? new List<object>();

    int countAll = ListSP.Count;
    int countCat1 = 0, countCat2 = 0, countCat3 = 0, countCat4 = 0, countCat5 = 0;
    foreach (var item in ListSP)
    {
        var cid = item.GetType().GetProperty("MaLoaiSP")?.GetValue(item, null)?.ToString();
        if (cid == "1") countCat1++;
        else if (cid == "2") countCat2++;
        else if (cid == "3") countCat3++;
        else if (cid == "4") countCat4++;
        else if (cid == "5") countCat5++;
    }
}

