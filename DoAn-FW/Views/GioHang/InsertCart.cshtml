@{
    ViewData["Title"] = "Thông Báo Giỏ Hàng - BIWEB";
}

<!-- Page Header Banner -->
<div class="bg-[#0F172A] text-white py-8 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute -top-12 right-0 w-64 h-64 bg-[#0052FF]/15 rounded-full blur-2xl pointer-events-none"></div>
    <div class="container mx-auto px-4 relative z-10">
        <div class="flex items-center space-x-2 text-xs text-[#00C6FF] font-medium mb-1">
            <a href="/Home/Index" class="hover:text-white no-underline text-[#00C6FF]">Trang chủ</a>
            <span class="text-slate-500">/</span>
            <a href="/GioHang/Cart" class="hover:text-white no-underline text-[#00C6FF]">Giỏ hàng</a>
            <span class="text-slate-500">/</span>
            <span class="text-white">Thông báo</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Thông Báo Trạng Thái Giỏ Hàng
        </h1>
    </div>
</div>

<div class="py-16 bg-[#F8FAFC] min-h-[60vh] flex items-center justify-center">
    <div class="container mx-auto px-4 max-w-lg">
        <div class="bi-card-white rounded-3xl border border-slate-200 p-8 shadow-sm text-center">
            <div class="w-20 h-20 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-3xl mx-auto mb-5 shadow-sm">
                <i class="fa fa-exclamation-circle"></i>
            </div>
            <h2 class="text-2xl font-black text-[#0F172A] mb-2">Số Lượng Không Đủ</h2>
            <p class="text-sm text-[#4B5563] mb-6 leading-relaxed">
                Số lượng License yêu cầu vượt quá số lượng bàn giao sẵn sàng hoặc phiên đăng ký chưa hoàn tất. Vui lòng giảm số lượng hoặc chọn gói bản quyền khác.
            </p>
            <div class="space-y-3">
                <a href="/GioHang/Cart" class="w-full py-3.5 px-6 rounded-xl font-bold text-sm text-white bi-btn-primary transition shadow-md block no-underline">
                    <i class="fa fa-shopping-cart mr-2"></i> Quay Lại Giỏ Hàng
                </a>
                <a href="/SanPham/Products" class="w-full py-3 px-6 rounded-xl font-bold text-xs text-[#4B5563] hover:text-[#0F172A] bg-slate-100 hover:bg-slate-200 transition block no-underline">
                    Khám Phá Các Giải Pháp Khác
                </a>
            </div>
        </div>
    </div>
</div>
