@{
    ViewData["Title"] = "Giỏ Hàng Giải Pháp & Bản Quyền - BIWEB";
    List<object> ListSP = ViewData["ListSP"] as List<object>;
    List<KhuyenMai> ListKM = ViewData["ListKM"] as List<KhuyenMai>;
    long SoLuong = 0;
    long Gia = 0;
    long ThanhTien = 0;
    long TongTien = 0;
}

<!-- Page Header Banner -->
<div class="bg-[#0F172A] text-white py-10 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute -top-20 right-0 w-80 h-80 bg-[#0052FF]/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="container mx-auto px-4 relative z-10">
        <div class="flex items-center space-x-2 text-xs text-[#00C6FF] font-medium mb-1">
            <a href="/Home/Index" class="hover:text-white no-underline text-[#00C6FF]">Trang chủ</a>
            <span class="text-slate-500">/</span>
            <span class="text-white">Giỏ hàng giải pháp</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Giỏ Hàng Giải Pháp Chuyển Đổi Số
        </h1>
        <p class="text-xs sm:text-sm text-slate-300 mt-1 m-0">
            Xem lại các gói bản quyền đã chọn, áp dụng mã ưu đãi và chuẩn bị nhận License bàn giao từ BIWEB
        </p>
    </div>
</div>

<div class="py-12 bg-[#F8FAFC] min-h-screen">
    <div class="container mx-auto px-4 max-w-6xl">
        
        @if (ListSP != null && ListSP.Count > 0)
        {
            <form method="post" action="/HoaDon/XacNhanHD" id="cartForm">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                    
                    <!-- Left Column: Cart Items List -->
                    <div class="lg:col-span-8 bi-card-white rounded-3xl border border-slate-200/90 p-6 sm:p-8 shadow-sm">
                        <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-100">
                            <h2 class="text-base sm:text-lg font-bold text-[#0F172A] flex items-center m-0">
                                <i class="fa fa-shopping-cart text-[#0052FF] mr-2.5"></i> 
                                Danh Sách Giải Pháp Trong Giỏ (@ListSP.Count gói bản quyền)
                            </h2>
                            <a href="/SanPham/Products" class="text-xs font-semibold text-[#0052FF] hover:text-[#00C6FF] no-underline transition">
                                + Thêm giải pháp khác
                            </a>
                        </div>

                        <div class="divide-y divide-slate-100">
                            @for (var i = 0; i < ListSP.Count; i++)
                            {
                                var ctsp = ListSP[i];
                                var id = ctsp.GetType().GetProperty("MaTTSP")?.GetValue(ctsp, null)?.ToString();
                                var name = ctsp.GetType().GetProperty("TenSP")?.GetValue(ctsp, null)?.ToString();
                                var img = ctsp.GetType().GetProperty("HinhAnh")?.GetValue(ctsp, null)?.ToString();
                                var loaiId = ctsp.GetType().GetProperty("MaLoaiSP")?.GetValue(ctsp, null)?.ToString();
                                var mauSac = ctsp.GetType().GetProperty("MauSac")?.GetValue(ctsp, null)?.ToString();
                                var ram = ctsp.GetType().GetProperty("Ram")?.GetValue(ctsp, null)?.ToString();
                                var boNho = ctsp.GetType().GetProperty("BoNhoTrong")?.GetValue(ctsp, null)?.ToString();
                                var khId = ctsp.GetType().GetProperty("MaKH")?.GetValue(ctsp, null)?.ToString();

                                long giaKM = 0;
                                long giaGoc = 0;
                                long.TryParse(ctsp.GetType().GetProperty("GiaKM")?.GetValue(ctsp, null)?.ToString(), out giaKM);
                                long.TryParse(ctsp.GetType().GetProperty("Gia")?.GetValue(ctsp, null)?.ToString(), out giaGoc);

                                Gia = (giaKM > 0) ? giaKM : giaGoc;
                                long.TryParse(ctsp.GetType().GetProperty("SoLuong")?.GetValue(ctsp, null)?.ToString(), out SoLuong);
                                if (SoLuong <= 0) { SoLuong = 1; }
                                ThanhTien = Gia * SoLuong;
                                TongTien += ThanhTien;

                                <div class="py-5 flex flex-wrap sm:flex-nowrap items-center justify-between gap-4 cart-row" data-index="@i" data-price="@Gia">
                                    <input name="MaTTSP[]" type="hidden" value="@id" />
                                    <input name="TenSP[]" type="hidden" value="@name - Gói @mauSac (@ram Luồng - @boNho Acc)" />
                                    <input name="Gia[]" type="hidden" value="@Gia" />

                                    <!-- Image & Name -->
                                    <div class="flex items-center space-x-3.5 flex-1 min-w-[200px]">
                                        <img src="@img" alt="@name" class="w-16 h-16 object-cover rounded-2xl border border-slate-200 flex-shrink-0" />
                                        <div>
                                            <a href="/SanPham/ChiTietSP?t=@id&l=@loaiId" class="text-sm font-bold text-[#0F172A] hover:text-[#0052FF] no-underline leading-snug line-clamp-2 transition">
                                                @name
                                            </a>
                                            <div class="flex flex-wrap items-center gap-1.5 mt-1 text-[11px] text-[#4B5563] font-medium">
                                                <span class="px-2 py-0.5 rounded-lg bg-[#0052FF]/10 text-[#0052FF] font-bold">@mauSac</span>
                                                <span>•</span>
                                                <span>@ram Luồng</span>
                                                <span>•</span>
                                                <span>@boNho Acc</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Unit Price -->
                                    <div class="text-right sm:text-center w-28">
                                        <div class="text-xs text-[#4B5563]">Đơn giá</div>
                                        <div class="text-sm font-bold text-[#0F172A]">
                                            @string.Format("{0:0,0 đ}", Gia)
                                        </div>
                                    </div>

                                    <!-- Quantity Stepper -->
                                    <div class="flex items-center space-x-1.5">
                                        <button type="button" onclick="changeQty(@i, -1)" class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-slate-200 text-[#0F172A] flex items-center justify-center font-bold text-xs transition border-0 cursor-pointer">
                                            -
                                        </button>
                                        <input type="number"
                                               id="qty_@i"
                                               name="SoLuong[]"
                                               value="@SoLuong"
                                               min="1"
                                               onchange="calcRowTotal(@i)"
                                               class="w-12 py-1 px-1 rounded-lg border border-slate-300 text-center font-bold text-xs focus:ring-2 focus:ring-[#0052FF] focus:outline-none text-[#0F172A]" />
                                        <button type="button" onclick="changeQty(@i, 1)" class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-slate-200 text-[#0F172A] flex items-center justify-center font-bold text-xs transition border-0 cursor-pointer">
                                            +
                                        </button>
                                    </div>

                                    <!-- Subtotal -->
                                    <div class="text-right w-32">
                                        <div class="text-xs text-[#4B5563]">Thành tiền</div>
                                        <div class="text-base font-black text-[#0052FF] row-total" id="row_total_@i" data-subtotal="@ThanhTien">
                                            @string.Format("{0:0,0 đ}", ThanhTien)
                                        </div>
                                    </div>

                                    <!-- Delete Button -->
                                    <div>
                                        <a href="/GioHang/DeleteCart?id=@id&kh=@khId" 
                                           onclick="return confirm('Bạn có chắc chắn muốn bỏ tool này khỏi giỏ hàng?')"
                                           class="w-8 h-8 rounded-xl bg-slate-50 hover:bg-rose-50 text-slate-400 hover:text-rose-600 flex items-center justify-center transition no-underline" 
                                           title="Xóa khỏi giỏ">
                                            <i class="fa fa-trash-alt text-xs"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Policy Footer in Cart -->
                        <div class="mt-8 pt-4 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-[#4B5563]">
                            <div class="flex items-center space-x-2">
                                <i class="fa fa-bolt text-[#FF6B00] text-sm"></i>
                                <span>Cấp License trong 30 giây</span>
                            </div>
                            <div class="flex items-center space-x-2">
                                <i class="fa fa-sync-alt text-[#0052FF] text-sm"></i>
                                <span>Update trọn đời miễn phí</span>
                            </div>
                            <div class="flex items-center space-x-2">
                                <i class="fa fa-headset text-[#10B981] text-sm"></i>
                                <span>Ultraview hỗ trợ cài đặt 1-1</span>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Order Summary & Coupon -->
                    <div class="lg:col-span-4 bi-card-white rounded-3xl border border-slate-200/90 p-6 shadow-sm sticky top-24 space-y-6">
                        <h3 class="text-base font-bold text-[#0F172A] pb-3 border-b border-slate-100 flex items-center m-0">
                            <i class="fa fa-receipt text-[#0052FF] mr-2"></i> Tóm Tắt Đơn Hàng
                        </h3>

                        <!-- Promo Code Selector -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-[#0F172A] mb-2">
                                <i class="fa fa-tag text-[#FF6B00] mr-1"></i> Mã Giảm Giá & Voucher:
                            </label>
                            <select name="MaKM" id="maKMSelect" onchange="updateSummary()" class="w-full p-3 rounded-xl border border-slate-300 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-[#0052FF] bg-[#F8FAFC] text-[#0F172A]">
                                @if (ListKM != null && ListKM.Count > 0)
                                {
                                    foreach (var km in ListKM)
                                    {
                                        <option value="@km.MaKM" data-pt="@km.SoPTKM" data-min="@km.TTienToiThieu">
                                            Giảm @km.SoPTKM% - Đơn từ @string.Format("{0:0,0 đ}", km.TTienToiThieu) (Hạn: @km.DenNgay.ToString("dd/MM/yyyy"))
                                        </option>
                                    }
                                }
                                else
                                {
                                    <option value="0" data-pt="0" data-min="0">Không có mã khuyến mãi</option>
                                }
                            </select>
                        </div>

                        <!-- Calculations -->
                        <div class="space-y-3 pt-2 text-xs">
                            <div class="flex justify-between text-[#4B5563]">
                                <span>Tổng tiền sản phẩm:</span>
                                <span class="font-bold text-[#0F172A] text-sm" id="subtotalDisplay">@string.Format("{0:0,0 đ}", TongTien)</span>
                            </div>
                            <div class="flex justify-between text-[#4B5563]">
                                <span>Giảm giá Voucher:</span>
                                <span class="font-bold text-[#10B981] text-sm" id="discountDisplay">-0 đ</span>
                            </div>
                            <div class="pt-3 border-t border-slate-200 flex justify-between items-baseline">
                                <span class="text-sm font-extrabold text-[#0F172A]">Tổng thanh toán:</span>
                                <span class="text-2xl font-black text-[#0052FF]" id="grandTotalDisplay">@string.Format("{0:0,0 đ}", TongTien)</span>
                            </div>
                        </div>

                        <!-- Checkout Button -->
                        <button type="submit" 
                                class="w-full py-4 rounded-2xl font-bold text-sm text-white bi-btn-primary shadow-lg transition-all duration-200 flex items-center justify-center space-x-2 border-0 cursor-pointer">
                            <span>TIẾN HÀNH XÁC NHẬN THANH TOÁN</span>
                            <i class="fa fa-arrow-right"></i>
                        </button>

                        <div class="text-[11px] text-center text-[#4B5563] leading-tight">
                            Bằng việc nhấn đặt hàng, bạn đồng ý với Điều khoản dịch vụ và chính sách bản quyền License của BIWEB.
                        </div>
                    </div>

                </div>
            </form>
        }
        else
        {
            <div class="bi-card-white rounded-3xl border border-slate-200/90 p-12 text-center max-w-lg mx-auto shadow-sm">
                <div class="w-20 h-20 rounded-full bg-[#0052FF]/10 text-[#0052FF] flex items-center justify-center text-3xl mx-auto mb-4">
                    <i class="fa fa-shopping-cart"></i>
                </div>
                <h3 class="text-lg font-bold text-[#0F172A] mb-2">Giỏ Hàng Của Bạn Đang Trống!</h3>
                <p class="text-xs sm:text-sm text-[#4B5563] mb-6 leading-relaxed">
                    Bạn chưa chọn gói phần mềm hay bản quyền tool nào. Hãy khám phá kho công cụ marketing & tự động hóa Facebook Ads ngay!
                </p>
                <a href="/SanPham/Products" class="inline-flex items-center px-6 py-3.5 rounded-2xl font-bold text-xs sm:text-sm text-white bi-btn-primary transition shadow-md no-underline">
                    <i class="fa fa-rocket mr-2"></i> Khám Phá Kho Tool Ngay
                </a>
            </div>
        }

    </div>
</div>

<script>
    function changeQty(index, delta) {
        var input = document.getElementById('qty_' + index);
        if (input) {
            var current = parseInt(input.value) || 1;
            var newVal = current + delta;
            if (newVal < 1) newVal = 1;
            input.value = newVal;
            calcRowTotal(index);
        }
    }

    function calcRowTotal(index) {
        var row = document.querySelector('.cart-row[data-index="' + index + '"]');
        if (!row) return;
        var unitPrice = parseInt(row.getAttribute('data-price')) || 0;
        var input = document.getElementById('qty_' + index);
        var qty = parseInt(input.value) || 1;
        var rowTotal = unitPrice * qty;

        var totalElem = document.getElementById('row_total_' + index);
        if (totalElem) {
            totalElem.setAttribute('data-subtotal', rowTotal);
            totalElem.innerText = rowTotal.toLocaleString('vi-VN') + ' đ';
        }
        updateSummary();
    }

    function updateSummary() {
        var rows = document.querySelectorAll('.cart-row');
        var grandSubtotal = 0;
        rows.forEach(function(r) {
            var idx = r.getAttribute('data-index');
            var totElem = document.getElementById('row_total_' + idx);
            if (totElem) {
                grandSubtotal += parseInt(totElem.getAttribute('data-subtotal')) || 0;
            }
        });

        var selectKM = document.getElementById('maKMSelect');
        var discount = 0;
        if (selectKM && selectKM.selectedIndex >= 0) {
            var opt = selectKM.options[selectKM.selectedIndex];
            var pt = parseInt(opt.getAttribute('data-pt')) || 0;
            var minSpend = parseInt(opt.getAttribute('data-min')) || 0;
            if (grandSubtotal >= minSpend && pt > 0) {
                discount = Math.floor((grandSubtotal * pt) / 100);
            }
        }

        var finalTotal = grandSubtotal - discount;
        if (finalTotal < 0) finalTotal = 0;

        var subDisplay = document.getElementById('subtotalDisplay');
        if (subDisplay) subDisplay.innerText = grandSubtotal.toLocaleString('vi-VN') + ' đ';

        var discDisplay = document.getElementById('discountDisplay');
        if (discDisplay) discDisplay.innerText = '-' + discount.toLocaleString('vi-VN') + ' đ';

        var grandDisplay = document.getElementById('grandTotalDisplay');
        if (grandDisplay) grandDisplay.innerText = finalTotal.toLocaleString('vi-VN') + ' đ';
    }

    // Run on load
    window.addEventListener('DOMContentLoaded', function() {
        updateSummary();
    });
</script>