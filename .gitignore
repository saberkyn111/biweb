# NuGet Packages
*.nupkg
*.snupkg
**/packages/
!**/packages/build/
*.nuget.props
*.nuget.targets

# OS Generated Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# Temp and Scratch directories
scratch/
tmp/
temp/
*.tmp
*.bak
*.swp

# Sensitive local configurations (keep appsettings.json, ignore secrets)
appsettings.*.local.json
secrets.json

# Large Binary Files (over 50MB) - Use external storage or Git LFS if needed
Docs/*.pdf.pdf
