.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.launchSettings.json.user
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
.idea/

# Roslyn & Compilers
*.codeanalysis
*.ruleset

# ASP.NET Core & Web Cache
project.lock.json
project.fragment.lock.json
artifacts/
*.StaticWebAssets.xml
*.StaticWebAssets.Manifest.cache
_ReSharper*/
